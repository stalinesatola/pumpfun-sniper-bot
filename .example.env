# Wallet secret key (base58). Never commit the real .env.
PVT_KEY=BASE58_PVT_KEY_HERE

# Endpoints (required)
RPC_URL=https://YOUR_RPC_HOST/?api-key=YOUR_KEY
ASTRALANE_URL=http://YOUR_ASTRALANE_HOST/iris?api-key=YOUR_KEY
SHREDSTREAM_URL=http://YOUR_SHREDSTREAM_HOST:9999

# Trading (optional, defaults shown)
SOL_BUY_AMOUNT=0.0001
BRIBE_FEE=0.0001
SELL_DELAY_SLOTS=7


# Dashboard (web). 127.0.0.1 keeps it local; set API_BIND=off to disable.
# API_TOKEN must be 16+ characters; if unset a random one is generated and logged on each start.
API_BIND=127.0.0.1:8787
API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# UI_DIR=ui/dist

# Risk limits (0 turns a limit off). Defaults shown.
MAX_OPEN_POSITIONS=3
MAX_SESSION_SPEND_SOL=1.0
MAX_SESSION_DRAWDOWN_SOL=0.5
BUY_SLIPPAGE_PERCENT=5
MIN_BALANCE_RESERVE_SOL=0.01
# Skip tokens by how much the creator buys at launch (SOL), by creator, or by name/symbol:
# MIN_DEV_BUY_SOL=0.5
# MAX_DEV_BUY_SOL=5
# BLOCKED_CREATORS=addr1,addr2
# BLOCKED_KEYWORDS=rug,test

# Copy-trade: mirror Pump.fun buys by these wallets (comma-separated). Empty = off.
# COPY_WALLETS=wallet1,wallet2
# COPY_BUY_SOL=0.001            # SOL per copied buy (default: SOL_BUY_AMOUNT)
# COPY_MIN_LEADER_SOL=0         # ignore leader buys below / above this (0 = no limit)
# COPY_MAX_LEADER_SOL=0
# COPY_SELL_WITH_LEADER=true    # sell when the leader sells the same token
# COPY_MAX_HOLD_SLOTS=150       # safety exit: sell after this many slots anyway
